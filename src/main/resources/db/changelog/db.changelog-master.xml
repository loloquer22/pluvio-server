<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:pro="http://www.liquibase.org/xml/ns/pro"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">
	<changeSet id="20230328" author="lolo">
		<createTable tableName="relevepluie">
			<column name="id" type="int()" autoIncrement="true">
        		<constraints nullable="false" unique="true" primaryKey="true" primaryKeyName="relevepluie_id_pk"/>
      		</column>	
			<column name="date" type="date">
				<constraints nullable="false" unique="true" />
			</column>
			<column name="jour" type="int(4)" defaultValue="null"></column>
			<column name="mois" type="int(4)" defaultValue="null"></column>
			<column name="annee" type="int(8)" defaultValue="null"></column>
			<column name="valeur" type="float" defaultValue="null"></column>
		</createTable>
		
		<addAutoIncrement tableName="relevepluie" columnName="id" columnDataType="bigint" startWith="1" incrementBy="1" />
		
    </changeSet>
</databaseChangeLog>